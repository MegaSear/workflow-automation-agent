# LLM provider
# use your configure
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=

# PostgreSQL
# default
POSTGRES_DB=dionysius
POSTGRES_USER=dionysius
POSTGRES_PASSWORD=dionysius
POSTGRES_PORT=5432

# Authentication
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# Application
DEBUG=true