# LLM provider
# use your configure
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=
LLM_MAX_COMPLETION_TOKENS=1024
LLM_TEMPERATURE=
LLM_TOP_P=
LLM_FREQUENCY_PENALTY=
LLM_PRESENCE_PENALTY=
LLM_SEED=
LLM_REASONING_EFFORT=

# PostgreSQL
# default
POSTGRES_DB=dionysius
POSTGRES_USER=dionysius
POSTGRES_PASSWORD=dionysius
POSTGRES_PORT=5432

# Authentication
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# Generate with: uv run python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
INTEGRATION_ENCRYPTION_KEY=

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
MY_DEFAULT_MCP_TOKEN=
MY_DEFAULT_MCP_URL=http://my-default:8001/mcp

# Remote MCP endpoints
JIRA_MCP_URL=
GOOGLE_CALENDAR_MCP_URL=
GITHUB_MCP_URL=https://api.githubcopilot.com/mcp/
