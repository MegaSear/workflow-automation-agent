# LLM provider
# OpenAI-Compitable
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=

# LLM configure
# Values example
LLM_MAX_COMPLETION_TOKENS=2048
LLM_TEMPERATURE=0.2
LLM_TOP_P=0.9
LLM_FREQUENCY_PENALTY=0.0
LLM_PRESENCE_PENALTY=0.0
LLM_SEED=42
LLM_REASONING_EFFORT=
LLM_WARMUP_ENABLED=False
MAX_TOOL_ROUNDS=10
LLM_TIMEOUT=120.0
LLM_MAX_RETRIES=0

# Components 
FRONTEND_URL=http://localhost:8080

# PostgreSQL
# default
POSTGRES_DB=dionysius
POSTGRES_USER=dionysius
POSTGRES_PASSWORD=dionysius
POSTGRES_PORT=5432

# Authentication
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# Generate with: uv run python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
INTEGRATION_ENCRYPTION_KEY=

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
MY_DEFAULT_MCP_TOKEN=
MY_DEFAULT_MCP_URL=http://my-default:8001/mcp

# Remote MCP endpoints
JIRA_MCP_URL=https://mcp.atlassian.com/v2/mcp/
GOOGLE_CALENDAR_MCP_URL=https://calendarmcp.googleapis.com/mcp/v1
GOOGLE_CALENDAR_REDIRECT_URI=http://localhost:8000/api/integrations/google_calendar/callback

GITHUB_MCP_URL=https://api.githubcopilot.com/mcp/

# Episodic Memory
EMBEDDING_PROVIDER=sentence_transformers
EMBEDDING_MODEL=intfloat/multilingual-e5-small
EMBEDDING_DEVICE=cpu

EPISODIC_MEMORY_EMBEDDING_DIMENSION=384
HNSW_M=16
HNSW_EF_CONSTRUCTION=64
HNSW_EF_SEARCH=100